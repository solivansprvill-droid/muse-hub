# ===== Muse 配置示例：复制为 .env 后按需填写（不填也能跑，走模拟模式）=====

# 端口
PORT=3000

# 访问密码（部署到公网强烈建议设置；浏览器会弹出登录框，用户名随意）
MUSE_PASSWORD=

# ---- LLM（OpenAI 兼容接口）：主要聊天 / Agent 下指令 / TradingAgents / 新闻改写 / 交易台 AI 审核 ----
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
# 智谱 GLM:  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
# 通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1              LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 军事情报：NASA FIRMS 实时火点（可选）申请：https://firms.modaps.eosdis.nasa.gov/api/map_key/ ----
FIRMS_MAP_KEY=
FIRMS_MAX_POINTS=4000

# ---- 新闻稿 ----
NEWS_SYNC_MINUTES=30        # 自动同步间隔（分钟），0 = 关闭自动同步
NEWS_REWRITE_LIMIT=8        # 每次同步最多让 LLM 改写多少条
NEWS_MAX_ITEMS=3000

# ---- 行情缓存（分钟）----
MARKET_CACHE_MINUTES=30

# ---- OpenMausBot 接入 Telegram（可选）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=  # 逗号分隔，留空 = 不限制（建议填自己的 chat id）

# 数据目录（默认 ./data）
# DATA_DIR=/data
